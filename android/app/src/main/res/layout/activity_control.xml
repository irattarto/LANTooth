<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="14dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="LANTooth"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Disconnect: small and pinned top-right, away from the one-handed thumb
         zone at the bottom where the PTT button lives, so it can't be hit by
         accident while reaching for the mic. Click handler in ControlActivity
         confirms before actually disconnecting. -->
    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="12dp"
        android:text="Disconnect"
        android:textSize="10sp"
        android:textColor="?attr/colorError"
        app:strokeColor="?attr/colorError"
        app:cornerRadius="15dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable settings: session mode / microphone / speaker. Ends above the
         PTT button (not behind it) so nothing scrolls under the fixed button. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvHost"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnMic">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- Session mode card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/LanToothSectionLabel"
                        android:text="Session mode" />

                    <LinearLayout
                        android:id="@+id/modeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeHeadset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Headset"
                            android:textSize="13sp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeMicOnly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mic Only"
                            android:textSize="13sp"
                            android:layout_marginStart="6dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvModeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Headset = hear PC audio here too. Mic Only = phone stays silent."
                        android:textSize="10sp"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Microphone card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/cardMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/LanToothSectionLabel"
                        android:text="Microphone" />

                    <Spinner
                        android:id="@+id/spinnerMic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use the button at the bottom of the screen to talk."
                        android:textSize="10sp"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Speaker (output device) card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOutput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/cardMic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/LanToothSectionLabel"
                        android:text="Speaker" />

                    <Spinner
                        android:id="@+id/spinnerOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Only used in Headset mode."
                        android:textSize="10sp"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Push-to-talk: large, round, pinned to the bottom center so it's
         reachable with one thumb regardless of scroll position. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMic"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Hold to\nTalk"
        android:textSize="14sp"
        android:textAlignment="center"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LanTooth.Circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Lock: toggles the mic to stay open continuously instead of requiring a
         held-down press. Sits beside the main button, not on top of it, so an
         accidental tap can't be mistaken for talking. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMicLock"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Lock"
        android:textSize="14sp"
        android:textAlignment="center"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LanTooth.Circle"
        app:layout_constraintStart_toEndOf="@id/btnMic"
        app:layout_constraintTop_toTopOf="@id/btnMic"
        app:layout_constraintBottom_toBottomOf="@id/btnMic"
        android:layout_marginStart="12dp" />

    <!-- Play/Pause: sends the PC a media play/pause key press (same as the
         keyboard media key). Mirrors the Lock button on the other side of PTT. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlayPause"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="Play /\nPause"
        android:textSize="14sp"
        android:textAlignment="center"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.LanTooth.Circle"
        app:layout_constraintEnd_toStartOf="@id/btnMic"
        app:layout_constraintTop_toTopOf="@id/btnMic"
        app:layout_constraintBottom_toBottomOf="@id/btnMic"
        android:layout_marginEnd="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
